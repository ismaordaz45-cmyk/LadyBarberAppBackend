# Configuración del Servidor
NODE_ENV=development
PORT=3000

# Configuración de Base de Datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lady_barber_db

# TLS MySQL (obligatorio para conexiones externas de QA)
DB_SSL=false
# Usa solo una de las siguientes variables cuando DB_SSL=true
DB_SSL_CA=
DB_SSL_CA_BASE64=

# Seguridad y Autenticación JWT
JWT_SECRET=tu_secreto_jwt_aqui
