# Configuración del Servidor
NODE_ENV=development
PORT=3000
BUSINESS_TIME_ZONE=America/Mexico_City

# Configuración de Base de Datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lady_barber_db

# TLS MySQL (obligatorio en producción)
DB_SSL=false
# Si el proveedor usa una CA pública, deja ambas vacías.
# Para una CA privada usa exclusivamente una de estas variables.
DB_SSL_CA=
DB_SSL_CA_BASE64=

# Seguridad y Autenticación JWT
JWT_SECRET=tu_secreto_jwt_aqui
